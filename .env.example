# ── ฐานข้อมูล ─────────────────────────────────────────────────────────────
# DB_HOST  = เซิร์ฟเวอร์ HOSxP (ข้อมูลผู้ป่วย ipt / iptdiag / iptoprt)
# DB_HOST2 = เซิร์ฟเวอร์ที่มี schema ppchos (ตาราง users สำหรับ login)
#            ถ้าเป็นเครื่องเดียวกัน ใส่ค่าเดียวกันได้เลย
DB_HOST=192.168.x.x
DB_HOST2=192.168.x.x
DB_PORT=3306
DB_USER=sa
DB_PASS=secret
DB_NAME=hos

# ── ระบบ auth ─────────────────────────────────────────────────────────────
# สร้าง secret ใหม่: openssl rand -hex 32
JWT_SECRET=change-me
# ตั้ง true เมื่อเสิร์ฟผ่าน https เท่านั้น
COOKIE_SECURE=false
