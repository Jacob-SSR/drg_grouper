-    return deny(req, res, true);
-  }
-});
-
-// ─────────────────────────────────────────────────────────────────────────────
-// AUTH ROUTES (โค้ดตรรกะเดียวกับ app/api/login, logout, me, change-password
-// ของ ppc-hos-10667)
-// ─────────────────────────────────────────────────────────────────────────────
