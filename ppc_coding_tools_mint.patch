+    (d.ops||[]).slice(0,5).forEach((c,i)=>{ document.getElementById("op"+(i+1)).value = c; });
+    (d.ops||[]).slice(5,8).forEach((c,i)=>{ document.getElementById("nop"+(i+1)).value = c; });
+    if(d.age!=null) document.getElementById("age").value = d.age;
+    if(d.los!=null) document.getElementById("los").value = d.los;
+    if(d.sex) document.getElementById("sex").value = d.sex;
+    // dchstts ของ HOSxP → ตัวเลือก 1-8 ของฟอร์ม (ตรงกันตามรหัสสถานะจำหน่าย)
+    if(d.dchstts && ["1","2","3","4","5","6","7","8"].includes(d.dchstts)){
+      document.getElementById("dchtype").value = d.dchstts;
+    }
+    const parts = [
+      `✅ AN ${d.an}`, d.ptname ? `ผู้ป่วย: ${d.ptname}` : null,
+      d.pdx ? `PDx ${d.pdx}` : "⚠️ ยังไม่มี PDx ในฐาน",
+      `SDx ${ (d.sdx||[]).length } รายการ`, `หัตถการ ${ (d.ops||[]).length } รายการ`,
+      d.adjrw!=null ? `AdjRW จริงในฐาน = ${Number(d.adjrw).toFixed(4)}` : null,
+    ].filter(Boolean);
+    st.textContent = parts.join(" · ");
+    st.style.color = "#0f766e";
+    calculate();
+  } catch {
+    st.textContent = "เชื่อมต่อเซิร์ฟเวอร์ไม่ได้"; st.style.color="#dc2626";
+  } finally {
+    btn.disabled = false;
+  }
