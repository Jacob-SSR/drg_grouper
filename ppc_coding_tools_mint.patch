+async function fetchFromHosxp(){
+  const an = document.getElementById("hosxp-an").value.trim();
+  const st = document.getElementById("hosxp-status");
+  const btn = document.getElementById("hosxp-btn");
+  if(!an){ st.textContent="กรุณาระบุ AN"; st.style.color="#dc2626"; return; }
+  btn.disabled = true; st.style.color="#64748b"; st.textContent="กำลังดึงข้อมูลจาก HOSxP…";
