+<body>
+<header>
+  <div>🔍</div>
+  <h1>Denile code checker program <span>By Dr.OraPat</span></h1>
+  <span class="badge">สปสช. AI Pre-Audit v2567</span>
+  <div style="margin-left:auto;display:flex;align-items:center;gap:10px;font-size:.8rem">
+    <a href="/" style="color:#fff;opacity:.85;text-decoration:none;font-size:.75rem;border:1px solid rgba(255,255,255,.35);border-radius:8px;padding:5px 12px">🏠 หน้าหลัก</a>
+    <a href="/tools/drg" style="color:#fff;opacity:.85;text-decoration:none;font-size:.75rem;border:1px solid rgba(255,255,255,.35);border-radius:8px;padding:5px 12px">🧮 DRG Grouper</a>
+    <span id="user-name" style="opacity:.9">👤 …</span>
+    <button onclick="doLogout()" style="background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.35);color:#fff;border-radius:8px;padding:5px 12px;cursor:pointer;font-size:.75rem">ออกจากระบบ</button>
+  </div>
+</header>
+<div class="container">
+
+<!-- HOSxP direct fetch -->
+<div class="bar" style="border:2px solid #0f766e;background:#f0fdfa">
+  <strong style="font-size:.9rem;color:#0f766e">📥 ดึงข้อมูลจริงจาก HOSxP</strong>
