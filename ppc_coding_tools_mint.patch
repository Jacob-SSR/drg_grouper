+
+<!-- Results -->
+<div id="resultSection">
+  <div class="stats">
+    <div class="stat s-total"><div class="num" id="cntTotal">0</div><div class="lbl">ทั้งหมด</div></div>
+    <div class="stat s-high"><div class="num" id="cntHigh">0</div><div class="lbl">🔴 ความเสี่ยงสูง</div></div>
+    <div class="stat s-med"><div class="num" id="cntMed">0</div><div class="lbl">🟡 ความเสี่ยงกลาง</div></div>
+    <div class="stat s-clean"><div class="num" id="cntClean">0</div><div class="lbl">✅ ผ่านการตรวจ</div></div>
