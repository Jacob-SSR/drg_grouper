-    // ── ชั้นที่ 1: จำกัดตาม IP — 10 ครั้ง / 5 นาที ──
-    const ipLimit = rateLimit(`login:ip:${ip}`, 10, 5 * MINUTE);
-    if (!ipLimit.ok) {
-      return tooManyRequests(res, ipLimit, "พยายาม login บ่อยเกินไป กรุณารอสักครู่");
