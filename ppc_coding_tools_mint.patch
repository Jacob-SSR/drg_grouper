+  // หาช่อง input ที่ list นี้สังกัด
+  const targetId = listId.replace('-list','');
+  const targetInput = document.getElementById(targetId);
+
+  q = q.trim();
+  // ถ้าพิมพ์เป็น ICD-10 code ให้ไม่แสดง dropdown (ปล่อยให้พิมพ์รหัสตรงๆ)
+  if(/^[A-Za-z]\d/.test(q) && q.length >= 3){
+    list.style.display='none'; return;
+  }
+  if(q.length < 1){ list.style.display='none'; return; }
+
+  const ql = q.toLowerCase();
+  const results = ICD10_DB.filter(([code,th,en])=>
+    th.toLowerCase().includes(ql) ||
+    en.toLowerCase().includes(ql) ||
+    code.toLowerCase().startsWith(ql)
+  ).slice(0,12);
+
+  if(!results.length){ list.style.display='none'; return; }
+
+  list.innerHTML = results.map(([code,th,en])=>
+    `<div class="diag-item" onclick="selectDiag('${code}','${th}','${targetId}','${listId}')">
+      <span class="diag-code">${code}</span>
+      <span class="diag-name">${th}<small>${en}</small></span>
+    </div>`
+  ).join('');
+  list.style.display='block';
+  _activeDropdown = listId;
+}
+
+function selectDiag(code, name, targetId, listId){
+  const inp = document.getElementById(targetId);
+  if(inp) inp.value = code;
+  // ถ้าเป็น search box แยก → ใส่ใน pdx
+  if(targetId === 'diag-search'){
+    document.getElementById('pdx').value = code;
+    inp.value = name + '  →  ' + code;
+  }
+  document.getElementById(listId).style.display='none';
+}
+
+// ปิด dropdown เมื่อคลิกข้างนอก
+document.addEventListener('click', e=>{
+  if(!e.target.closest('.field-group')){
+    document.querySelectorAll('.diag-dropdown').forEach(d=>d.style.display='none');
+  }
+});
